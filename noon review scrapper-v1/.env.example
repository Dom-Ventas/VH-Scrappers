# ─── API ──────────────────────────────────────────────────────────────────────
# Production. The backend authenticates every scrapper endpoint — Amazon,
# Flipkart and Noon alike — against one shared static bearer
# (settings.scrapper_api_token), so this is the same token the other scrapers
# use. Never commit the real value; .env is gitignored.
#
# To develop against the local mock instead:
#   QUERIES_API_URL=http://localhost:4000/api/v1/scrapper/noon/review-queries
#   RESULTS_API_URL=http://localhost:4000/api/v1/scrapper/noon/reviews
API_TOKEN=

QUERIES_API_URL=https://domventas.info/backend/api/v1/scrapper/noon/review-queries
RESULTS_API_URL=https://domventas.info/backend/api/v1/scrapper/noon/reviews

# ─── SCRAPER ──────────────────────────────────────────────────────────────────
SCRAPER_PROFILE_DIR=./chrome-profile

SCRAPE_DELAY_MS=30000

DEFAULT_NOON_LOCALE=www.noon.com/uae-en

# Comma-separated allow-list, e.g. NNAE,NNSA. Empty = scrape everything.
SCRAPE_SHORT_CODES=

# Cap on critical reviews collected per SKU. Noon SKUs can carry 30k+ reviews
# and pagination is scroll-driven, so keep this modest.
MAX_CRITICAL_REVIEWS=200

# 1 = show the browser window. Otherwise it runs off-screen — but always headed,
# since noon blocks headless Chrome. Unattended Linux runs need xvfb-run.
BROWSER_VISIBLE=

# ─── MOCK SERVER ──────────────────────────────────────────────────────────────
MOCK_PORT=4000
