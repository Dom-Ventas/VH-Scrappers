# ─── API ──────────────────────────────────────────────────────────────────────
# VentaWiz server root (no /api prefix). Blank = the value in src/embedded.ts.
# The endpoints default to ${VH_API_ROOT}/v1/scrapper/review-queries and
# ${VH_API_ROOT}/v1/scrapper/reviews; QUERIES_API_URL / RESULTS_API_URL
# override them in full (the agent sets both).
VH_API_ROOT=
QUERIES_API_URL=
RESULTS_API_URL=

# VentaWiz service account (OAuth client_credentials against the VentaWiz auth
# service). The agent passes all three to every scraper it launches; set them
# here only for a standalone run. Ask a VentaWiz admin for a service account
# with scrapper:run — the secret is shown once, when it is created. Never
# commit the real secret; .env is gitignored.
#   VW_AUTH_URL      auth service root (token exchange: POST /v1/token).
#                    Blank = the value in src/embedded.ts (http://localhost:8100).
VW_AUTH_URL=
VW_CLIENT_ID=
VW_CLIENT_SECRET=

# VentaWiz store ids, comma-separated positive integers (the agent sets this).
# Blank = storeIds from user-settings.json; a first standalone run asks for them.
SCRAPE_STORE_IDS=

# Sent as marketplace= on the queue request. Defaults to noon.
SCRAPE_MARKETPLACE=

# ─── SCRAPER ──────────────────────────────────────────────────────────────────
SCRAPER_PROFILE_DIR=./chrome-profile

SCRAPE_DELAY_MS=30000

DEFAULT_NOON_LOCALE=www.noon.com/uae-en

# Optional local allow-list on short_code, e.g. NNAE,NNSA. Empty = everything.
SCRAPE_SHORT_CODES=

# Cap on critical reviews collected per SKU. Noon SKUs can carry 30k+ reviews
# and pagination is scroll-driven, so keep this modest.
MAX_CRITICAL_REVIEWS=200

# 1 = show the browser window. Otherwise it runs off-screen — but always headed,
# since noon blocks headless Chrome. Unattended Linux runs need xvfb-run.
BROWSER_VISIBLE=

# ─── MOCK SERVER ──────────────────────────────────────────────────────────────
MOCK_PORT=4000
