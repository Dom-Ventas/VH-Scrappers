# Copy this file to .env and fill in the values.

# VentaWiz server root (no /api prefix). Leave blank to use the value in
# src/embedded.ts. The endpoint paths below are appended to it.
VH_API_ROOT=

# Full URL overrides (the agent sets these). When blank they default to
#   ${VH_API_ROOT}/v1/scrapper/review-queries
#   ${VH_API_ROOT}/v1/scrapper/reviews
QUERIES_API_URL=
RESULTS_API_URL=

# VentaWiz service account (OAuth client_credentials against the VentaWiz auth
# service). The agent passes all three to every scraper it launches; set them
# here only for a standalone run. Ask a VentaWiz admin for a service account
# with scrapper:run — the secret is shown once, when it is created. Never
# commit the real secret; .env is gitignored.
#   VW_AUTH_URL      auth service root (token exchange: POST /v1/token).
#                    Blank = the value in src/embedded.ts (http://localhost:8100).
VW_AUTH_URL=
VW_CLIENT_ID=
VW_CLIENT_SECRET=


# VentaWiz store ids to scrape, comma-separated positive integers (the agent
# sets this). When blank, storeIds from user-settings.json are used, and a
# first standalone run shows the setup form to ask for them.
SCRAPE_STORE_IDS=

# Sent as marketplace= on the queue request. Defaults to ebay.
SCRAPE_MARKETPLACE=

# Where the persistent Chrome profile + user-settings.json live.
# Leave empty to use the default: %LOCALAPPDATA%\EbayReviewScrapper\chrome-profile
SCRAPER_PROFILE_DIR=

# Delay between consecutive products, in milliseconds.
# Default 30000 (30 seconds) to stay clear of eBay's bot detection (Akamai).
SCRAPE_DELAY_MS=30000

# Cap on critical (1-2 star) reviews collected per product. eBay serves 10
# per reviews page, so 100 = up to 10 page loads per product.
MAX_CRITICAL_REVIEWS=100

# Pause between review pages of one product, in milliseconds.
REVIEW_PAGE_DELAY_MS=2000

# eBay host opened on the first-run onboarding page (post-save redirect).
DEFAULT_EBAY_DOMAIN=www.ebay.com

# Optional comma-separated marketplace short codes to scrape (empty = all).
# Example: SCRAPE_SHORT_CODES=EBUS,EBDE
SCRAPE_SHORT_CODES=

# Show the Chrome scraper window on screen. Set to 1 to debug; otherwise the
# window launches off-screen so you can keep working in other apps while the
# scraper runs. The first run (when no user-settings.json exists) is always
# visible regardless of this setting.
BROWSER_VISIBLE=
