{
  "name": "ventahub-agent",
  "version": "1.0.0",
  "description": "VentaHub launcher agent: checks in with VentaHub, runs the scraper(s) assigned to this laptop, and reports run results. Ships as a single Windows exe alongside the scraper exes.",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "build:exe": "tsc && pkg dist/index.js --targets node20-win-x64 --output dist/VentaHubAgent.exe"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@yao-pkg/pkg": "^5.16.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "pkg": {
    "assets": [
      "node_modules/playwright-core/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ]
  }
}
