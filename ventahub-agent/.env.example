# Optional: copy this to `.env` next to VentaHubAgent.exe. Normally no .env
# is needed — the agent asks for its VentaWiz service account (client ID +
# client secret) on first run and keeps it in agent-config.json in its home.
# The .env is gitignored — a real secret must NEVER be committed to source.

# Dev only: override the service account saved at first run. Both must be set.
VW_CLIENT_ID=
VW_CLIENT_SECRET=

# VentaWiz auth service root (token exchange: POST /v1/token). Leave unset to
# use the root baked into the exe.
VW_AUTH_URL=http://localhost:8100

# VentaWiz server root. Endpoints are /v1/scrapper/... directly under it (no
# /api prefix). Leave unset to use the root baked into the exe.
VH_API_ROOT=http://localhost:8000

# Amazon domain used for the one-time login on first run.
DEFAULT_AMAZON_DOMAIN=www.amazon.in

# Debug: set to 1 to show the child scraper browser windows (default off-screen).
BROWSER_VISIBLE=0

# Dev only: folder containing the scraper exes. Defaults to the folder the
# agent exe lives in (so ship all three exes in one folder).
VH_SCRAPER_DIR=
