# Copy this to `.env` next to VentaHubAgent.exe and fill in API_TOKEN.
# The .env is gitignored — the token must NEVER be committed to source.

# REQUIRED: static scrapper Bearer token (same value as the backend's
# SCRAPPER_API_TOKEN). The agent refuses to run without it.
API_TOKEN=

# VentaHub server root (matches the backend root_path "/backend").
VH_API_ROOT=https://domventas.info/backend

# Amazon domain used for the one-time login on first run.
DEFAULT_AMAZON_DOMAIN=www.amazon.in

# Debug: set to 1 to show the child scraper browser windows (default off-screen).
BROWSER_VISIBLE=0

# Dev only: folder containing the scraper exes. Defaults to the folder the
# agent exe lives in (so ship all three exes in one folder).
VH_SCRAPER_DIR=
