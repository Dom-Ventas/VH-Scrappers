# ─── BACKEND API (VentaWiz) ──────────────────────────────────────────────────
# Server root, no /api prefix. Defaults to src/embedded.ts (a local dev server).
# VH_API_ROOT=https://<ventawiz-host>

# Full URLs override VH_API_ROOT; the agent sets both from its assignment.
# Defaults: <VH_API_ROOT>/v1/scrapper/review-queries and /v1/scrapper/reviews
# QUERIES_API_URL=https://<ventawiz-host>/v1/scrapper/review-queries
# RESULTS_API_URL=https://<ventawiz-host>/v1/scrapper/reviews

# VentaWiz service account (OAuth client_credentials against the VentaWiz auth
# service). The agent passes all three to every scraper it launches; set them
# here only for a standalone run. Ask a VentaWiz admin for a service account
# with scrapper:run — the secret is shown once, when it is created. Never
# commit the real secret; .env is gitignored.
#   VW_AUTH_URL      auth service root (token exchange: POST /v1/token).
#                    Blank = the value in src/embedded.ts (http://localhost:8100).
VW_AUTH_URL=
VW_CLIENT_ID=
VW_CLIENT_SECRET=

# VentaWiz store ids, comma separated (set by the agent). When blank, the store
# ids entered on the first-run form are used.
SCRAPE_STORE_IDS=

# Sent as marketplace= on the queue request. Defaults to flipkart.
SCRAPE_MARKETPLACE=

# ─── SCRAPER ──────────────────────────────────────────────────────────────────

SCRAPER_PROFILE_DIR=

SCRAPE_DELAY_MS=30000

# Delay between review pages of the same product. Flipkart throttles harder
# than Amazon and one product can cost MAX_REVIEW_PAGES requests.
REVIEW_PAGE_DELAY_MS=1500

# Flipkart has no server-side critical-review filter, so every review page has
# to be fetched and filtered locally. These two bound the cost per product.
MAX_REVIEW_PAGES=30
MAX_CRITICAL_REVIEWS=200

DEFAULT_FLIPKART_DOMAIN=www.flipkart.com

# Comma separated, e.g. FKIN
SCRAPE_SHORT_CODES=

# Set to 1 to force a visible browser window on a configured install.
BROWSER_VISIBLE=
