# Copy this file to .env and fill in the values.

# VentaWiz server root (no /api prefix — endpoints start with /v1/scrapper/...).
# Used to build the two URLs below when they are not set.
VH_API_ROOT=http://localhost:8000

# Search-term queue. Defaults to ${VH_API_ROOT}/v1/scrapper/search-term-queries.
QUERIES_API_URL=

# Where results are POSTed. Defaults to ${VH_API_ROOT}/v1/scrapper/search-term-results.
RESULTS_API_URL=

# VentaWiz service account (OAuth client_credentials against the VentaWiz auth
# service). The agent passes all three to every scraper it launches; set them
# here only for a standalone run. Ask a VentaWiz admin for a service account
# with scrapper:run — the secret is shown once, when it is created. Never
# commit the real secret; .env is gitignored.
#   VW_AUTH_URL      auth service root (token exchange: POST /v1/token).
#                    Blank = the value in src/embedded.ts (http://localhost:8100).
VW_AUTH_URL=
VW_CLIENT_ID=
VW_CLIENT_SECRET=

# VentaWiz store ids to scrape, comma-separated (the agent sets this). When
# empty, the store ids saved by the first-run form in user-settings.json are used.
SCRAPE_STORE_IDS=

# Sent as marketplace= on the queue request. Default: amazon.
SCRAPE_MARKETPLACE=amazon

# Optional local filter on the queue items' short_code, e.g. AZAE,AZIN. Empty = all.
SCRAPE_SHORT_CODES=

# 1 also counts Sponsored Brands banner tiles as sponsored results. Leave off:
# VentaWiz only counts sponsored products in the grid.
INCLUDE_SPONSORED_BRANDS=0

# Where the persistent Chrome profile + user-settings.json live.
# Leave empty to use the default: %LOCALAPPDATA%\SearchTermScrapper\chrome-profile
SCRAPER_PROFILE_DIR=

# Delay between consecutive scrapes, in milliseconds. Default 14000.
SCRAPE_DELAY_MS=14000

# Default Amazon domain for the first-run onboarding page (post-save redirect).
DEFAULT_AMAZON_DOMAIN=www.amazon.in

# Show the Chrome scraper window on screen. Set to 1 to debug; otherwise the
# window launches off-screen so you can keep working in other apps while the
# scraper runs. The first run (when no user-settings.json exists and
# SCRAPE_STORE_IDS is empty) is always visible regardless of this setting,
# since the user has to interact with the setup form and sign into Amazon.
BROWSER_VISIBLE=
