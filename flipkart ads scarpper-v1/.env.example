# Copy this file to .env and fill in the values.

# VentaWiz server root (no /api prefix). Endpoints below are joined onto it.
# Defaults to the value in src/embedded.ts (a local dev server).
VH_API_ROOT=

# Full URLs override VH_API_ROOT. Leave blank to use
#   <VH_API_ROOT>/v1/scrapper/search-term-queries   (GET, paginated queue)
#   <VH_API_ROOT>/v1/scrapper/search-term-results   (POST, one per search)
# The agent sets both from the backend's assignment.
QUERIES_API_URL=
RESULTS_API_URL=

# VentaWiz service account (OAuth client_credentials against the VentaWiz auth
# service). The agent passes all three to every scraper it launches; set them
# here only for a standalone run. Ask a VentaWiz admin for a service account
# with scrapper:run — the secret is shown once, when it is created. Never
# commit the real secret; .env is gitignored.
#   VW_AUTH_URL      auth service root (token exchange: POST /v1/token).
#                    Blank = the value in src/embedded.ts (http://localhost:8100).
VW_AUTH_URL=
VW_CLIENT_ID=
VW_CLIENT_SECRET=

# VentaWiz store ids to scrape, comma-separated (set by the agent). When blank,
# the store ids entered on the first-run form are used.
SCRAPE_STORE_IDS=

# Sent as marketplace= on the queue request. Defaults to flipkart.
SCRAPE_MARKETPLACE=

# Where the persistent Chrome profile + user-settings.json live.
# Leave empty to use the default: %LOCALAPPDATA%\FlipkartSearchTermScrapper\chrome-profile
SCRAPER_PROFILE_DIR=

# Delay between consecutive scrapes, in milliseconds.
# Default 30000 (30 seconds) to avoid Flipkart rate-limiting.
SCRAPE_DELAY_MS=30000

# Default Flipkart domain for the first-run onboarding page (post-save redirect).
DEFAULT_FLIPKART_DOMAIN=www.flipkart.com

# Optional comma-separated marketplace short codes to scrape (empty = all).
# Example: SCRAPE_SHORT_CODES=FKIN
SCRAPE_SHORT_CODES=

# Show the Chrome scraper window on screen. Set to 1 to debug; otherwise the
# window launches off-screen so you can keep working in other apps while the
# scraper runs. The first run (when no user-settings.json exists) is always
# visible regardless of this setting, since the user has to interact with
# the setup form and sign into Flipkart.
BROWSER_VISIBLE=
