# Copy this file to .env and fill in the values.

# API that returns the list of search terms / ASINs to scrape.
# Your fetchQueries() adapter in src/api/queries.ts will read this.
QUERIES_API_URL=https://example.com/api/queries

# API that receives scraped results. Your postScrapedResult() adapter
# in src/api/results.ts will POST to this URL.
RESULTS_API_URL=https://example.com/api/results

# Bearer token (or whatever auth scheme your API uses).
API_TOKEN=replace-me

# Where the persistent Chrome profile + user-settings.json live.
# Leave empty to use the default: %LOCALAPPDATA%\SearchTermScrapper\chrome-profile
SCRAPER_PROFILE_DIR=

# Delay between consecutive scrapes, in milliseconds.
# Default 30000 (30 seconds) to avoid Amazon rate-limiting.
SCRAPE_DELAY_MS=30000

# Default Amazon domain for the first-run onboarding page (post-save redirect).
DEFAULT_AMAZON_DOMAIN=www.amazon.in
